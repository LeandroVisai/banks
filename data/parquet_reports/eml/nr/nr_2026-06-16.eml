    }
    // =E2=94=80=E2=94=80 Tooltip individual (barras, torta, composici=C3=B3n=
) =E2=94=80=E2=94=80=E2=94=80=E2=94=80=E2=94=80=E2=94=80=E2=94=80=E2=94=80=E2=
=94=80=E2=94=80=E2=94=80=E2=94=80=E2=94=80=E2=94=80=E2=94=80=E2=94=80=E2=94=
=80=E2=94=80=E2=94=80=E2=94=80=E2=94=80=E2=94=80
    svg.addEventListener('mouseover',function(e){
      var el=3De.target.closest('.tip-pt');
      if(!el) return;
      var c=3Del.getAttribute('data-c')||'#0b3766',s=3Del.getAttribute('data-=
s')||'',
          k=3Del.getAttribute('data-k')||'',v=3Del.getAttribute('data-v')||'';
      tip.innerHTML=3D(k?'<div class=3D"ct-k">'+esc(k)+'</div>':'')+
        '<div class=3D"ct-r"><span class=3D"ct-sw" style=3D"background:'+esc(=
c)+'"></span>'+
        (s?'<span class=3D"ct-s">'+esc(s)+'</span>':'')+(v?'<span class=3D"ct=
-v">'+esc(v)+'</span>':'')+'</div>';
      tip.style.display=3D'block';move(e);
    });
    svg.addEventListener('mousemove',function(e){if(tip.style.display=3D=3D=
=3D'block')move(e);});
    svg.addEventListener('mouseout',function(e){if(e.target.closest('.tip-pt'=
))hide();});
  });
})();
</script>
