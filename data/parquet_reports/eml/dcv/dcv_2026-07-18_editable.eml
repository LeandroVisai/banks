  <script>
(function(){
  var tip=3Ddocument.getElementById('chart-tip');
  if(!tip) return;
  function esc(s){var d=3Ddocument.createElement('div');d.textContent=3Ds;ret=
urn d.innerHTML;}
  function move(e){
    var pad=3D14,w=3Dtip.offsetWidth,h=3Dtip.offsetHeight,
        x=3De.clientX+pad,y=3De.clientY+pad;
    if(x+w>window.innerWidth)x=3De.clientX-w-pad;
    if(y+h>window.innerHeight)y=3De.clientY-h-pad;
    tip.style.left=3Dx+'px';tip.style.top=3Dy+'px';
  }
  function hide(){tip.style.display=3D'none';}
  // Coordenadas pantalla =E2=86=92 viewBox SVG.
  function svgCoords(svg,e){
    var pt=3Dsvg.createSVGPoint();pt.x=3De.clientX;pt.y=3De.clientY;
    return pt.matrixTransform(svg.getScreenCTM().inverse());
  }
  // Re-apila las series VISIBLES de un gr=C3=A1fico apilado (=C3=A1rea/barra=
) recomputando
  // su geometr=C3=ADa con el eje fijo embebido en data-stack: al ocultar una=
 serie las
  // dem=C3=A1s se completan hacia la base en vez de dejar un hueco. Replica =
exactamente
  // el apilado divergente de svg_chart.py (positivos sobre 0, negativos bajo=
 0).
  function restack(svg){
    var raw=3Dsvg.getAttribute('data-stack');
    if(!raw) return;
    var st; try{st=3DJSON.parse(raw);}catch(err){return;}
    var span=3D(st.ymax-st.ymin)||1;
    function py(v){return st.top+st.ph*(1-(v-st.ymin)/span);}
    function visible(i){
      var lg=3Dsvg.querySelector('.lg-item[data-idx=3D"'+i+'"]');
      return !lg||lg.getAttribute('data-hidden')!=3D=3D'1';
    }
    if(st.k=3D=3D=3D'area'){
      var X=3Dst.x,n=3DX.length,pos=3D[],neg=3D[];
      for(var k=3D0;k<n;k++){pos.push(0);neg.push(0);}
      st.s.forEach(function(ser){
        if(!visible(ser.i)) return;  // oculta: no acumula ni se redibuja
        var poly=3Dsvg.querySelector('polygon[data-si=3D"'+ser.i+'"]');
        if(!poly) return;
        var upper=3D[],lower=3D[];
        for(var j=3D0;j<n;j++){
          var v=3Dser.v[j],lo,hi;
          if(v>=3D0){lo=3Dpos[j];hi=3Dpos[j]+v;pos[j]=3Dhi;}
          else{hi=3Dneg[j];lo=3Dneg[j]+v;neg[j]=3Dlo;}
          upper.push(X[j].toFixed(1)+','+py(hi).toFixed(1));
          lower.push(X[j].toFixed(1)+','+py(lo).toFixed(1));
        }
        lower.reverse();
        poly.setAttribute('points',upper.join(' ')+' '+lower.join(' '));
      });
    } else if(st.k=3D=3D=3D'bar'){
      var ncat=3Dst.s.length?st.s[0].v.length:0;
      for(var ci=3D0;ci<ncat;ci++){
        var posAcc=3D0,negAcc=3D0;
        st.s.forEach(function(ser){
          if(!visible(ser.i)) return;  // oculta: no acumula
          var v=3Dser.v[ci],yTop,yBot;
          if(v>=3D0){yTop=3Dpy(posAcc+v);yBot=3Dpy(posAcc);posAcc+=3Dv;}
          else{yTop=3Dpy(negAcc);yBot=3Dpy(negAcc+v);negAcc+=3Dv;}
          var rect=3Dsvg.querySelector('rect[data-si=3D"'+ser.i+'"][data-ci=
=3D"'+ci+'"]');
          if(rect){
            rect.setAttribute('y',Math.min(yTop,yBot).toFixed(1));
            rect.setAttribute('height',Math.abs(yBot-yTop).toFixed(1));
          }
        });
      }
    }
  }
  document.querySelectorAll('svg.report-chart').forEach(function(svg){
    // =E2=94=80=E2=94=80 Leyenda clickeable =E2=94=80=E2=94=80=E2=94=80=E2=
=94=80=E2=94=80=E2=94=80=E2=94=80=E2=94=80=E2=94=80=E2=94=80=E2=94=80=E2=94=
=80=E2=94=80=E2=94=80=E2=94=80=E2=94=80=E2=94=80=E2=94=80=E2=94=80=E2=94=80=
=E2=94=80=E2=94=80=E2=94=80=E2=94=80=E2=94=80=E2=94=80=E2=94=80=E2=94=80=E2=
=94=80=E2=94=80=E2=94=80=E2=94=80=E2=94=80=E2=94=80=E2=94=80=E2=94=80=E2=94=
=80=E2=94=80=E2=94=80=E2=94=80=E2=94=80=E2=94=80=E2=94=80=E2=94=80=E2=94=80=
=E2=94=80=E2=94=80=E2=94=80=E2=94=80=E2=94=80=E2=94=80=E2=94=80
    svg.querySelectorAll('.lg-item').forEach(function(lg){
      lg.addEventListener('click',function(){
        var idx=3Dlg.getAttribute('data-idx');
        var off=3Dlg.getAttribute('data-hidden')=3D=3D=3D'1';
        if(off){
          lg.removeAttribute('data-hidden');lg.style.opacity=3D'';
          svg.querySelectorAll('[data-si=3D"'+idx+'"]').forEach(function(el){=
el.style.display=3D'';});
        } else {
          lg.setAttribute('data-hidden','1');lg.style.opacity=3D'0.25';
          svg.querySelectorAll('[data-si=3D"'+idx+'"]').forEach(function(el){=
el.style.display=3D'none';});
        }
        restack(svg);  // re-apila las visibles (=C3=A1rea/barra apilada); no=
-op si no hay data-stack
      });
    });
    // =E2=94=80=E2=94=80 Crosshair unificado + highlight de serie m=C3=A1s c=
ercana =E2=94=80=E2=94=80=E2=94=80=E2=94=80=E2=94=80=E2=94=80=E2=94=80=E2=94=
=80=E2=94=80=E2=94=80=E2=94=80=E2=94=80=E2=94=80=E2=94=80=E2=94=80=E2=94=80=
=E2=94=80
    var ptsRaw=3Dsvg.getAttribute('data-pts');
    var pts=3Dnull;
    if(ptsRaw){try{pts=3DJSON.parse(ptsRaw);}catch(err){}}
    var guide=3Dsvg.querySelector('.x-guide');
    var overlay=3Dsvg.querySelector('.hover-overlay');
    if(pts&&overlay&&guide){
      var lastSI=3D-1;
      // Aplica highlight a la serie activa y aten=C3=BAa las dem=C3=A1s (sol=
o cuando cambia).
      function setActive(si){
        if(si=3D=3D=3DlastSI) return;
        lastSI=3Dsi;
        svg.querySelectorAll('[data-si]').forEach(function(el){
          if(el.style.display=3D=3D=3D'none') return;
          var esi=3DparseInt(el.getAttribute('data-si'));
          if(si<0){
            el.style.opacity=3D'';
            if(el.tagName=3D=3D=3D'polyline')el.style.strokeWidth=3D'';
          } else if(esi=3D=3D=3Dsi){
            el.style.opacity=3D'1';
            if(el.tagName=3D=3D=3D'polyline')el.style.strokeWidth=3D'2.8';
          } else {
            el.style.opacity=3D'0.2';
            if(el.tagName=3D=3D=3D'polyline')el.style.strokeWidth=3D'1.2';
          }
        });
      }
      overlay.addEventListener('mousemove',function(e){
        var sc=3DsvgCoords(svg,e),mx=3Dsc.x,my=3Dsc.y;
        // Fecha m=C3=A1s cercana (eje X).
        var best=3Dpts[0],bd=3DInfinity;
        for(var i=3D0;i<pts.length;i++){var d=3DMath.abs(pts[i].x-mx);if(d<bd=
){bd=3Dd;best=3Dpts[i];}}
        guide.setAttribute('x1',best.x);guide.setAttribute('x2',best.x);
        guide.removeAttribute('display');
        // Series visibles (no ocultas por leyenda).
        var vis=3Dbest.vals.filter(function(r){
          var lg=3Dsvg.querySelector('.lg-item[data-idx=3D"'+r.i+'"]');
          return !lg||lg.getAttribute('data-hidden')!=3D=3D'1';
        });
        if(!vis.length){setActive(-1);hide();return;}
        // Serie m=C3=A1s cercana en Y (si los datos tienen coordenada y).
        var closestSI=3D-1;
        if(vis[0].y!=3D=3Dundefined){
          var minDY=3DInfinity;
          vis.forEach(function(r){var d=3DMath.abs(r.y-my);if(d<minDY){minDY=
=3Dd;closestSI=3Dr.i;}});
        }
        setActive(closestSI);
        // Tooltip: todas las series; la m=C3=A1s cercana en negrita.
        var rows=3Dvis.map(function(r){
          var hi=3D(r.i=3D=3D=3DclosestSI);
          return '<div class=3D"ct-r'+(hi?' ct-r-hi':'')+'">'+
            '<span class=3D"ct-sw" style=3D"background:'+esc(r.c)+'"></span>'+
            '<span class=3D"ct-s"'+(hi?' style=3D"color:#000;font-weight:700"=
':'')+'>'+esc(r.s)+'</span>'+
            '<span class=3D"ct-v">'+esc(r.v)+'</span></div>';
        }).join('');
        tip.innerHTML=3D'<div class=3D"ct-k">'+esc(best.k)+'</div>'+rows;
        tip.style.display=3D'block';move(e);
      });
      overlay.addEventListener('mouseleave',function(){
        guide.setAttribute('display','none');
        setActive(-1);
        hide();
      });
      return;
    }
