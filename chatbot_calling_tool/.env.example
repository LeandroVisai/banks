# =============================================================================
# Configuración del chatbot agentic. Copia a `.env` y ajusta lo necesario.
# =============================================================================

# ── LLM ───────────────────────────────────────────────────────────────────────
# Para tool calling se requiere un modelo que lo soporte:
#   ✓ Qwen3.6-35B-A3B   (Qwen tool format, Hermes-style)
#   ✓ Kimi-K2-Instruct  (function calling nativo)
CHATBOT_MODEL_NAME=Qwen3.6-35B-A3B
CHATBOT_QUANTIZATION=fp8
CHATBOT_TENSOR_PARALLEL=1
CHATBOT_GPU_MEM_UTIL=0.90
CHATBOT_MAX_MODEL_LEN=16384            # más contexto: trazas + resultados de tools acumulados
CHATBOT_MAX_TOKENS=2048                # respuestas más largas (puede incluir tool calls)
CHATBOT_TEMPERATURE=0.2                # más bajo: tool calling necesita JSON disciplinado
CHATBOT_TOP_P=0.9

# ── Agente ────────────────────────────────────────────────────────────────────
MAX_AGENT_ITERATIONS=6                  # cuántas rondas de tool calling permitir
MAX_TOOL_RESULT_TOKENS=1500             # truncar resultados de tools muy largos
TOOL_TRACE_ENABLED=true                 # guarda trace completo en chat_messages

# ── Embeddings ────────────────────────────────────────────────────────────────
EMBEDDING_MODEL_ID=intfloat/multilingual-e5-small

# ── PostgreSQL ────────────────────────────────────────────────────────────────
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=rag_banco
PG_POOL_MIN=2
PG_POOL_MAX=8

# ── RAG ───────────────────────────────────────────────────────────────────────
RAG_TABLE_PREFIX=qwen_
RAG_RECALL_N=30
RRF_K=60
MMR_LAMBDA=0.65

# ── Conversación ──────────────────────────────────────────────────────────────
HISTORY_MAX_TURNS=10

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8081                           # diferente a chatbot/ (8080) para correr en paralelo
LOG_LEVEL=INFO
LOG_JSON=false
