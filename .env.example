# .env.example — configuración de producción (H100 offline).
# Copia a `.env` en la raíz del repo. Settings (pydantic) lee con prefijo BANKS_;
# las vars de RAG/PG legacy van sin prefijo. Los modelos se cargan LOCALMENTE
# desde models/<owner>--<name>/ (sin descarga ni red).

# ── LLM (Qwen3.6-27B GGUF, definitivo) ───────────────────────────────────────
BANKS_LLM_FAMILY=qwen
# Ruta relativa a models/ ; se resuelve con model_path_resolved.
BANKS_LLM_MODEL_PATH=Qwen3.6-27B-UD-Q4_K_XL.gguf
BANKS_LLM_N_CTX=16384
BANKS_LLM_N_GPU_LAYERS=-1
BANKS_LLM_TEMPERATURE=0.2
BANKS_LLM_MAX_TOKENS=2048

# ── Embeddings (Qwen3-VL-Embedding-8B, multimodal 4096-dim, definitivo) ───────
# Se resuelve a models/Qwen3-VL-Embedding-8B/. Debe ser el MISMO modelo con que
# se vectorizó el corpus (ver banks-ingest run).
RAG_EMBEDDING_MODEL=Qwen3-VL-Embedding-8B
# Peso de la imagen en el dual embedding de chunks visuales (solo IPoM).
RAG_VISUAL_IMG_WEIGHT=0.7

# ── PostgreSQL ────────────────────────────────────────────────────────────────
PGHOST=localhost
PGPORT=5432
PGDATABASE=rag_banco
PGUSER=postgres
PGPASSWORD=postgres

# ── API ───────────────────────────────────────────────────────────────────────
BANKS_API_HOST=0.0.0.0
BANKS_API_PORT=8080
BANKS_LOG_JSON=true
# BANKS_API_KEYS=key1,key2          # CSV; vacío = sin auth

# ── Chat logging ────────────────────────────────────────────────────────────
BANKS_CHAT_LOG_ENABLED=true
# BANKS_CHAT_LOG_DIR=data/chat_logs
