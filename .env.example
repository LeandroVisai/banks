# ==============================================================================
#  .env.example — copia a `.env` en la raíz del repo y ajusta lo necesario.
#
#  SOLO las variables con prefijo BANKS_ se leen de este archivo (pydantic
#  Settings, env_prefix="BANKS_"). Las PG* y RAG_* NO se leen del .env: van en
#  el ENTORNO DEL PROCESO (run_local_cpu.ps1 o $env: antes de uvicorn). Ver el
#  bloque del final y docs/SETUP_SERVIDOR.txt.
#
#  Modelos: se cargan LOCALMENTE desde models/<owner>--<name>/ (sin red).
# ==============================================================================

# ── LLM (modelo generador — Qwen3.6-27B GGUF) ─────────────────────────────────
BANKS_LLM_FAMILY=qwen
# Ruta relativa a models/. Ajusta al nombre real de tu carpeta/archivo .gguf.
BANKS_LLM_MODEL_PATH=unsloth--Qwen3.6-27B-GGUF/Qwen3.6-27B-UD-Q4_K_XL.gguf
BANKS_LLM_N_GPU_LAYERS=-1
BANKS_LLM_TEMPERATURE=0.2

# ── Contexto y longitud de respuesta ──────────────────────────────────────────
BANKS_LLM_N_CTX=50000             # ventana de contexto = memoria del chatbot. El
                                  # modelo entrena con 262144; 50000 cabe en la
                                  # H100. Más N_CTX = más VRAM (KV cache).
BANKS_LLM_MAX_TOKENS=4096         # tokens por paso intermedio (análisis de cada
                                  # especialista + su thinking). Subir si los
                                  # análisis se truncan; más alto = más latencia
                                  # (se genera en cada iteración × especialista).
BANKS_SYNTHESIS_MAX_TOKENS=10000  # tokens de la RESPUESTA FINAL (tope; subir si
                                  # se trunca). prompt + salida <= N_CTX.
BANKS_HISTORY_MAX_TURNS=40        # nº de mensajes que recuerda el chatbot

# ── Agente ────────────────────────────────────────────────────────────────────
BANKS_MAX_AGENT_ITERATIONS=6
BANKS_MAX_TOOL_RESULT_TOKENS=1500  # tope de tokens que un resultado de tool
                                   # puede ocupar en el contexto del agente
BANKS_THINKING_MODE=adaptive       # off | adaptive | on  (el toggle del front lo
                                   # sobreescribe por consulta)

# ── Reranker (cross-encoder de search_documents) ──────────────────────────────
BANKS_RERANK_ENABLED=true         # jina-reranker-v3 disponible en models/jinaai--jina-reranker-v3/
# BANKS_RERANK_MODEL=jinaai/jina-reranker-v3  # default; resuelve a models/jinaai--jina-reranker-v3/

# ── Corpus de contexto actual (noticias scrapeadas) ───────────────────────────
# Base de datos Postgres AISLADA del corpus del banco. La tool
# search_current_context SOLO consulta esta base; search_documents SOLO consulta
# PGDATABASE. El agente no puede cruzar corpus por error.
BANKS_CONTEXT_DB=contexto_actual          # nombre de la base Postgres aislada
BANKS_CONTEXT_WINDOW_DAYS=20              # ventana por defecto (días) si el
                                          # agente no pide fechas explícitas.
                                          # La ingesta es aditiva (no purga);
                                          # solo acota la búsqueda.
BANKS_CONTEXT_RECENCY_WEIGHT=0.30         # peso de recencia en el ranking de
                                          # noticias (alto = lo reciente manda)

# ── Análisis de documentos adjuntos (uploads, map-reduce) ─────────────────────
BANKS_UPLOAD_ANALYSIS_MAX_TOKENS=4096    # tokens de la respuesta final del análisis
BANKS_UPLOAD_MAP_BATCH_TOKENS=3500       # texto del doc por lote de map
BANKS_UPLOAD_MAP_MAX_TOKENS=1024         # tokens de cada análisis parcial (map)
BANKS_UPLOAD_MAX_MAP_BATCHES=24          # techo de lotes (docs gigantes)
BANKS_UPLOAD_MAX_VISUALS=6               # gráficos del PDF a mostrar en la UI

# ── Generador de noticias JARVIS (texto + audio TTS) ──────────────────────────
BANKS_TTS_ENABLED=true           # true para generar audio (voz JARVIS).
BANKS_TTS_ENGINE=piper            # 'piper' (default): voz JARVIS AUTÉNTICA neural.
                                  #   EN = JARVIS británico (jgkawell/jarvis),
                                  #   ES = voz latina 'gevy' (es_MX). 2 modelos en
                                  #   models/ + bundle ~40 MB (build_tts_piper_bundle).
                                  # 'sapi' (fallback): voz del SO + DSP, SIN modelos.
# Solo si engine=piper (rutas por defecto, relativas a models/):
# BANKS_TTS_MODEL=jgkawell--jarvis/jarvis-medium.onnx              # voz EN
# BANKS_TTS_MODEL_ES=es_MX-gevy/es_MX-gevy-10196-epoch-high.onnx   # voz ES

# ── Catálogo semántico de datasets (descubrimiento por embeddings) ─────────────
BANKS_CATALOG_SEMANTIC=false      # true para activar descubrimiento semántico del
                                  # catálogo SQL; requiere el embedder cargado.

# ── API / logging ─────────────────────────────────────────────────────────────
BANKS_API_HOST=0.0.0.0
BANKS_API_PORT=8080
BANKS_LOG_LEVEL=INFO
BANKS_LOG_JSON=true               # logs JSON estructurados (producción)
# BANKS_API_KEYS=key1,key2        # CSV; vacío = sin auth
BANKS_RATE_LIMIT_RPM=60           # requests por minuto por API key (0 = sin límite)
BANKS_CHAT_LOG_ENABLED=true       # persiste cada turno en data/chat_logs/
# BANKS_CHAT_LOG_DIR=data/chat_logs

# ── Observabilidad (OpenTelemetry) ─────────────────────────────────────────────
BANKS_TRACING=off                 # 'off' (default) o 'otlp' para exportar trazas
                                  # OTLP al collector (p.ej. Jaeger). Requiere
                                  # opentelemetry-sdk + opentelemetry-exporter-otlp.

# ==============================================================================
#  ⚠️ ESTAS NO SE LEEN DEL .env — fíjalas en el ENTORNO DEL PROCESO
#     (run_local_cpu.ps1 o en la sesión PowerShell antes de arrancar uvicorn):
#
#    $env:PGHOST="localhost"; $env:PGPORT="5432"; $env:PGDATABASE="rag_banco"
#    $env:PGUSER="postgres";  $env:PGPASSWORD="postgres"
#    $env:RAG_EMBEDDING_MODEL="Qwen3-VL-Embedding-8B"  # = al modelo del corpus
#    $env:RAG_VISUAL_IMG_WEIGHT="0.7"
#    $env:RAG_TABLE_PREFIX=""                           # prefijo de tablas en BD
# ==============================================================================
