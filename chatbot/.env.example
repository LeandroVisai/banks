# =============================================================================
# Configuración del chatbot. Copia a `.env` y ajusta lo necesario.
# Todos los valores tienen defaults razonables en app/settings.py.
# =============================================================================

# ── LLM ───────────────────────────────────────────────────────────────────────
CHATBOT_MODEL_NAME=Qwen3.6-35B-A3B
CHATBOT_QUANTIZATION=fp8
CHATBOT_TENSOR_PARALLEL=1
CHATBOT_GPU_MEM_UTIL=0.90
CHATBOT_MAX_MODEL_LEN=8192
CHATBOT_MAX_TOKENS=1024
CHATBOT_TEMPERATURE=0.3
CHATBOT_TOP_P=0.9

# ── Embeddings (RAG queries) ──────────────────────────────────────────────────
EMBEDDING_MODEL_ID=Qwen/Qwen3-Embedding

# ── PostgreSQL ────────────────────────────────────────────────────────────────
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=rag_banco
PG_POOL_MIN=2
PG_POOL_MAX=8

# ── RAG retrieval ─────────────────────────────────────────────────────────────
RAG_TABLE_PREFIX=qwen_
RAG_TOP_K=5
RAG_RECALL_N=30
RRF_K=60
MMR_LAMBDA=0.65
IMPORTANCE_BOOST=0.15

# ── Conversación ──────────────────────────────────────────────────────────────
HISTORY_MAX_TURNS=10

# ── Modo testing ──────────────────────────────────────────────────────────────
# CHATBOT_SKIP_DB=1  → omite PostgreSQL completamente (sin RAG, sin historial)
# USE_CPU_LLM=1      → usa transformers en CPU en vez de vLLM (sin GPU requerida)
CHATBOT_SKIP_DB=false
USE_CPU_LLM=0

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8080
LOG_LEVEL=INFO
LOG_JSON=false

# ── Presupuesto de tokens del prompt (deja espacio para la respuesta) ─────────
PROMPT_TOKEN_BUDGET=6500

# ── Data Warehouse — módulo Get_Data ─────────────────────────────────────────
# Directorio que contiene Get_Data.py (el mismo que usa querys/Monitor.py).
# En producción (Windows): D:\GOM\DACE\Nacho\Modulos
# En desarrollo/Linux: /ruta/a/Modulos
GET_DATA_PATH=D:\GOM\DACE\Nacho\Modulos
